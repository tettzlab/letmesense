# AI Provider API Keys (for --llm/--vision modes) 
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_GENERATIVE_AI_API_KEY=...
OLLAMA_HOST=http://localhost:11434

# Logging level (default: 'warn' for CLI)
LOG_LEVEL=info  # debug, info, warn, error

# OpenTelemetry (optional)
# When OTEL_EXPORTER_OTLP_ENDPOINT is set, full OTEL tracing/metrics are enabled.
# Traces and metrics are exported to the OTLP endpoint (not stdout).
# Set OTEL_SDK_DISABLED=true to temporarily disable (kill switch).
# Start local Grafana stack: docker compose up -d
# View at: http://localhost:3000 (admin/admin)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=letmesense
# OTEL_SDK_DISABLED=true  # Uncomment to disable OTEL
