{
  "name": "letmesense",
  "author": {
    "name": "tettz",
    "url": "https://github.com/tettzlab"
  },
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Extract text from PDFs and Office documents (DOCX, PPTX, XLSX) with OCR fallback for scanned content.",
  "keywords": [
    "pdf",
    "ocr",
    "text-extraction",
    "document",
    "docx",
    "pptx",
    "xlsx",
    "office",
    "tesseract",
    "llm",
    "vision",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tettzlab/letmesense.git"
  },
  "homepage": "https://github.com/tettzlab/letmesense",
  "bugs": {
    "url": "https://github.com/tettzlab/letmesense/issues"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.27.0",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./api": {
      "types": "./dist/lib/sense/api.d.ts",
      "import": "./dist/lib/sense/api.js",
      "default": "./dist/lib/sense/api.js"
    },
    "./pipeline": {
      "types": "./dist/lib/pipeline/index.d.ts",
      "import": "./dist/lib/pipeline/index.js",
      "default": "./dist/lib/pipeline/index.js"
    },
    "./ai": {
      "types": "./dist/lib/ai/index.d.ts",
      "import": "./dist/lib/ai/index.js",
      "default": "./dist/lib/ai/index.js"
    }
  },
  "bin": {
    "letmesense": "./dist/cli/letmesense.js",
    "letmedense": "./dist/cli/letmedense.js"
  },
  "scripts": {
    "all": "pnpm clean:all && pnpm validate:full && pnpm build && pnpm link --global",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf --glob build coverage coverage-cli coverage-full test-results .playwright-mcp node_modules/.cache node_modules/.vite-temp .DS_Store Thumbs.db \"*.log\" \"*.tsbuildinfo\"",
    "clean:all": "pnpm clean && rimraf dist out experiments",
    "cli": "tsx cli/letmesense.ts",
    "cli:dense": "tsx cli/letmedense.ts",
    "otel:up": "docker compose up -d",
    "otel:down": "docker compose down",
    "otel:logs": "docker compose logs -f",
    "otel:open": "open http://localhost:3000 || xdg-open http://localhost:3000 || start http://localhost:3000",
    "otel:cli": "OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 tsx cli/letmesense.ts",
    "fixtures:generate": "tsx samples/generate-fixtures.ts && tsx lib/office/fixtures/generate-fixtures.ts && tsx cli/fixtures/generate-image-fixtures.ts",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:unused:fix": "knip --fix",
    "lint:unused": "knip",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:full:cov": "vitest run --config vitest.full.config.ts --coverage",
    "test:full": "vitest run --config vitest.full.config.ts",
    "test:parity": "./scripts/test-api-parity.sh",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "validate:static": "concurrently -g \"pnpm typecheck\" \"pnpm lint\"",
    "validate": "pnpm validate:static && pnpm test",
    "validate:full": "pnpm validate:static && pnpm test:full",
    "audit": "pnpm audit --prod",
    "validate:license": "./scripts/check-licenses.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/azure": "^3.0.42",
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/openai": "^3.0.41",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^0.1.96",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.213.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.213.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.213.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/instrumentation-http": "^0.213.0",
    "@opentelemetry/instrumentation-pino": "^0.59.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-logs": "^0.213.0",
    "@opentelemetry/sdk-metrics": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/sdk-trace-base": "^2.6.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "adm-zip": "^0.5.16",
    "ai": "^6.0.116",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "franc": "^6.2.0",
    "gpt-tokenizer": "^3.4.0",
    "jsdom": "^28.1.0",
    "llama3-tokenizer-js": "^1.2.0",
    "officeparser": "^6.0.4",
    "ollama-ai-provider": "^1.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.5.207",
    "pino": "^10.3.1",
    "pino-abstract-transport": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.2",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-31808"
      ]
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@playwright/mcp": "^0.0.68",
    "@types/adm-zip": "^0.5.7",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^25.5.0",
    "@types/pdfkit": "^0.17.5",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.0",
    "concurrently": "^9.2.1",
    "exceljs": "^4.4.0",
    "knip": "^5.86.0",
    "mcp-remote": "^0.1.38",
    "pdfkit": "^0.17.2",
    "playwright": "^1.58.2",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.5",
    "vitest": "^4.1.0"
  }
}
