{
  "name": "letmesense",
  "author": {
    "name": "tettz",
    "url": "https://github.com/tettzlab"
  },
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Extract text from PDFs and Office documents (DOCX, PPTX, XLSX) with OCR fallback for scanned content.",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.27.0",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./api": {
      "types": "./dist/lib/letmesense/api.d.ts",
      "import": "./dist/lib/letmesense/api.js"
    },
    "./pipeline": {
      "types": "./dist/lib/pipeline/index.d.ts",
      "import": "./dist/lib/pipeline/index.js"
    },
    "./ai": {
      "types": "./dist/lib/ai/index.d.ts",
      "import": "./dist/lib/ai/index.js"
    }
  },
  "bin": {
    "letmesense": "./dist/cli/letmesense.js"
  },
  "scripts": {
    "all": "pnpm clean:all && pnpm validate:full && pnpm build && pnpm link --global",
    "build": "tsc -p tsconfig.json",
    "clean": "pnpm clean:all",
    "clean:all": "rimraf build dist out .react-router coverage coverage-cli coverage-full test-results .playwright-mcp node_modules/.cache node_modules/.vite-temp .DS_Store Thumbs.db \"*.log\" \"*.tsbuildinfo\"",
    "cli": "tsx cli/letmesense.ts",
    "dev:analyze": "tsx scripts/analyze-treacherous.ts",
    "dev:extract:scanned": "tsx scripts/extract-text.ts samples/scanned-image.pdf --kind scanned-image --ocrLang eng",
    "dev:extract": "tsx scripts/extract-text.ts samples/born-digital.pdf",
    "dev:split": "tsx scripts/split-treacherous.ts",
    "otel:up": "docker compose up -d",
    "otel:down": "docker compose down",
    "otel:logs": "docker compose logs -f",
    "otel:open": "open http://localhost:3000 || xdg-open http://localhost:3000 || start http://localhost:3000",
    "otel:cli": "OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 tsx cli/letmesense.ts",
    "fixtures:generate": "tsx cli/fixtures/generate-image-fixtures.ts",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:unused:fix": "knip --fix",
    "lint:unused": "knip",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:full:cov": "vitest run --config vitest.full.config.ts --coverage",
    "test:full": "vitest run --config vitest.full.config.ts",
    "test:parity": "./scripts/test-api-parity.sh",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm typecheck && pnpm lint && pnpm test",
    "validate:full": "pnpm typecheck && pnpm lint && pnpm test:full",
    "validate:license": "./scripts/check-licenses.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.7",
    "@ai-sdk/google": "^3.0.6",
    "@ai-sdk/openai": "^3.0.6",
    "@lenml/tokenizer-claude": "^3.7.2",
    "@lenml/tokenizer-gemini": "^3.7.2",
    "@napi-rs/canvas": "^0.1.68",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.211.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.211.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.208.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/instrumentation-http": "^0.208.0",
    "@opentelemetry/instrumentation-pino": "^0.55.1",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-logs": "^0.211.0",
    "@opentelemetry/sdk-metrics": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "adm-zip": "^0.5.16",
    "ai": "^6.0.6",
    "commander": "^12.1.0",
    "dotenv": "^17.2.3",
    "franc": "^6.2.0",
    "gpt-tokenizer": "^3.4.0",
    "jsdom": "^24.0.0",
    "llama3-tokenizer-js": "^1.2.0",
    "officeparser": "^6.0.4",
    "ollama-ai-provider": "^1.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.530",
    "pino": "^10.1.0",
    "pino-abstract-transport": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.34.5",
    "tesseract.js": "^6.0.0",
    "xlsx": "0.18.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@playwright/mcp": "^0.0.54",
    "@types/adm-zip": "^0.5.5",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^22",
    "@types/pdfkit": "^0.17.4",
    "@vitest/coverage-v8": "^4.0.16",
    "knip": "^5.80.0",
    "mcp-remote": "^0.1.37",
    "pdfkit": "^0.17.2",
    "playwright": "^1.58.0",
    "rimraf": "^6.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.16"
  }
}
